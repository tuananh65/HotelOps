# Copy to /opt/hotelops/shared/production.env; chmod 600. Never commit real values.
# Bash-compatible assignments; quote values. Do not use spaces around '='.
IMAGE_REGISTRY='ACCOUNT.dkr.ecr.REGION.amazonaws.com'
IMAGE_TAG='REPLACE_WITH_40_CHARACTER_COMMIT_SHA'
MSSQL_PID='Express'
MSSQL_SA_PASSWORD='REPLACE_WITH_RANDOM_SQL_ADMIN_PASSWORD'
# Required only when provisioning a new least-privilege SQL application login.
DB_APP_PASSWORD='REPLACE_WITH_DIFFERENT_RANDOM_APP_PASSWORD'
DATABASE_NAME='HotelOpsCompactDB'
DB_CONNECTION_FILE='/opt/hotelops/shared/db-connection.txt'
TLS_DIRECTORY='/etc/letsencrypt'
ACME_DIRECTORY='/var/www/certbot'
BACKUP_DIRECTORY='/opt/hotelops/shared/backups'
BACKUP_S3_URI=''
STATE_DIRECTORY='/opt/hotelops/shared/state'
PUBLIC_URL='https://hotelops.ap.vn'
# Set only for a local CI certificate signed by the supplied test CA.
HEALTHCHECK_CA=''
HEALTHCHECK_RESOLVE=''
