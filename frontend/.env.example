# HTTPS API proxy. FS-002 DEV1 room board uses API; other screens remain prototypes.
API_PROXY_TARGET=https://localhost:7443
# Local-only PEM files for browser-facing HTTPS. Never commit private keys.
# DEV_HTTPS_CERT=C:/local-certs/localhost.pem
# DEV_HTTPS_KEY=C:/local-certs/localhost-key.pem
# For an untrusted local backend CA, configure NODE_EXTRA_CA_CERTS outside Git.

# FS-002 DEV1 read transport; same-origin path only. No credentials in Vite env.
VITE_DEV1_API_BASE_URL=/api
