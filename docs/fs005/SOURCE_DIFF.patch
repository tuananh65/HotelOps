+  await page.getByLabel("Chi nhánh (ID)", { exact: true }).fill("8");
+  await page.getByRole("button", { name: "Tải dữ liệu", exact: true }).click();
+  await expect(
+    page.getByText("Không có công việc phù hợp bộ lọc."),
