+﻿import { test, expect } from "@playwright/test";
+// HTTP interception only; separate from FS005 live SQL acceptance.
+const item = {
+  kind: "cleaning",
+  id: 12,
+  cleaningTaskId: 12,
+  taskNumber: "API-CL-12",
+  roomId: 3,
+  roomNumber: "101",
+  floorId: 2,
